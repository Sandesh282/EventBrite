# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string.
# Get it from: https://console.neon.tech → your project → Connection string
# Enable "Connection pooling" in the Neon dashboard (recommended for Vercel).
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require

# Secret key for POST /api/events.
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=your-secret-key-here

# --- Setup workflow ----------------------------------------------------------
# 1. Fill in this file and save as .env.local
# 2. npm run db:generate   → creates drizzle/migrations/ SQL files
# 3. npm run db:migrate    → applies migrations to Neon
# 4. npm run db:seed       → populates tables from lib/events.ts static data
# 5. npm run dev           → start local dev server
