# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string.
# Get it from: https://console.neon.tech → your project → Connection string
# Enable "Connection pooling" in the Neon dashboard (recommended for Vercel).
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require

# Secret key for POST /api/events.
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=your-secret-key-here

# JWT secrets — used for signing access and refresh tokens (Phase 3).
# Generate separate strong random values for each:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Using different secrets means a leaked access token cannot forge refresh tokens.
JWT_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# --- Setup workflow ----------------------------------------------------------
# 1. Fill in this file and save as .env.local
# 2. npx tsx --env-file=.env.local scripts/migrate.ts  → applies all migrations
# 3. npm run db:seed       → populates tables from lib/events.ts static data
# 4. npm run dev           → start local dev server
